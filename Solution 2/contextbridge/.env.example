# Copy to .env and fill in.

# Required. Either an Anthropic key from https://console.anthropic.com/,
# or the key for whatever Anthropic-compatible endpoint you point at below.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Any endpoint exposing an Anthropic-compatible /v1/messages —
# e.g. a local model router. Accepts `http://host:port` or `http://host:port/v1`.
# Leave blank to talk to api.anthropic.com directly.
# ANTHROPIC_BASE_URL=http://127.0.0.1:31415/v1

# Model / generation.
# Against a router these can be routing aliases (auto, auto:fast, auto:smart)
# instead of literal model ids.
CLAUDE_MODEL=claude-sonnet-4-6

# Model for the per-chunk map phase. Summarization is one call per chunk, so
# routing it to a cheaper tier is the biggest cost lever here.
# Defaults to CLAUDE_MODEL when unset.
# SUMMARY_MODEL=auto:fast

MAX_OUTPUT_TOKENS=4096

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=80
MIN_CHUNK_SIZE=100

# Context budget
CONTEXT_BUDGET_TOKENS=150000
RESPONSE_RESERVE_TOKENS=4096

# Memory tiers
SHORT_TERM_EXCHANGES=5
MID_TERM_SUMMARY_EXCHANGES=20
ENTITY_STORE_MAX_ENTRIES=100

# Retrieval
TOP_K_CHUNKS=8
SIMILARITY_THRESHOLD=0.35

# Summarization
SUMMARY_CHUNK_BATCH_SIZE=5
MAX_SUMMARY_LEVELS=3
SUMMARY_CONCURRENCY=6

# Storage
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=contextbridge_docs

# Embeddings.
# Local by default (sentence-transformers -> ChromaDB ONNX -> hashing fallback).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Optional: an OpenAI-compatible /embeddings endpoint. Takes priority over the
# local backends and needs no model download. EMBEDDING_API_KEY defaults to
# ANTHROPIC_API_KEY when unset.
# NOTE: changing embedding backend changes vector width — delete
# data/chroma_db and re-ingest when you switch.
# EMBEDDING_BASE_URL=http://127.0.0.1:31415/v1
# EMBEDDING_REMOTE_MODEL=auto
# EMBEDDING_API_KEY=

# Frontend -> backend
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO
