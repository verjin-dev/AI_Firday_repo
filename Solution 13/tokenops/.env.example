# TokenOps runs entirely offline on simulated telemetry.
# An API key is only needed if you meter real Claude calls through /api/trace.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001
OFFLINE=true

SQLITE_URL=sqlite:///./data/db/tokenops.db
API_HOST=127.0.0.1
API_PORT=8013
LOG_LEVEL=INFO

# Simulation
SIM_DAYS=30
SIM_SESSIONS_PER_DAY=1200
SIM_SEED=13
